{
  "name": "mcproc",
  "version": "0.14.2",
  "description": "pm2 process control for agents over MCP: local and remote hosts, per-app ports, one manifest per project",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "pm2",
    "process-manager",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "developer-tools",
    "cli",
    "tui",
    "terminal-dashboard",
    "typescript",
    "nodejs",
    "ssh",
    "docker",
    "dev-server",
    "log-monitoring",
    "monorepo",
    "turborepo"
  ],
  "homepage": "https://github.com/kiwagu/mcproc#readme",
  "bugs": {
    "url": "https://github.com/kiwagu/mcproc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiwagu/mcproc.git"
  },
  "type": "module",
  "license": "MIT",
  "author": "Kiwagu",
  "bin": {
    "mcproc": "dist/cli.js"
  },
  "files": [
    "dist",
    "runtime/package.json",
    "runtime/package-lock.json",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:it": "MCPROC_IT=1 vitest run test/integration",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pm2/blessed": "0.1.81",
    "commander": "^15.0.0",
    "pm2": "7.0.4",
    "yaml": "^2.9.1",
    "zod": "^3.25"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
